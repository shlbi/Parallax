# Planned backend configuration contract. The current frontend demo does not
# consume these settings and does not require keys. Never put real values here.
# Local overrides, once implemented: .env.local or the encrypted local vault.
# Hosted deployment: server-side Vercel/backend environment settings.

PARALLAX_RUNTIME=local
PARALLAX_SECRET_BACKEND=local_vault

# Browser-delivered Google key: restrict by HTTP referrer and enabled API.
# Separate keys for localhost and the production domain are recommended.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=

# Private provider credentials: never expose these to browser code.
GOOGLE_MAPS_SERVER_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Only required for a NASA endpoint that explicitly requests an api.nasa.gov key.
# Public GIBS imagery and EONET event endpoints do not use this key.
NASA_API_KEY=

# Planned persistent services. Use separate local and hosted credentials.
DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Private worker endpoint for hosted long-running analysis; not a public client URL.
PARALLAX_WORKER_URL=
PARALLAX_WORKER_TOKEN=

# Optional future cloud dashboard vault. Never store this beside vault ciphertext.
PARALLAX_VAULT_MASTER_KEY=
