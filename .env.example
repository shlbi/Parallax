# Never put real credentials in this file. See backend/README.md.
# Batch 2 active settings: the Next.js /api/core gateway uses the first four.
# The Python service separately reads runtime, public origin, allowed hosts,
# gateway secret and DATABASE_URL from its own process environment.
PARALLAX_RUNTIME=local
PARALLAX_API_BASE_URL=http://127.0.0.1:8000
PARALLAX_PUBLIC_ORIGIN=http://localhost:3000
PARALLAX_GATEWAY_SECRET=
PARALLAX_ALLOWED_HOSTS=localhost,127.0.0.1

# Active for the Python service only. Empty in LOCAL mode uses OS user-data SQLite.
# CLOUD mode requires postgresql+psycopg:// and a separately deployed backend.
DATABASE_URL=

# Planned integration/vault settings below remain inactive in Batch 2.
# Adding provider keys does not connect a provider in this release.
PARALLAX_SECRET_BACKEND=local_vault
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_SERVER_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
NASA_API_KEY=
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
PARALLAX_WORKER_URL=
PARALLAX_WORKER_TOKEN=
PARALLAX_VAULT_MASTER_KEY=
